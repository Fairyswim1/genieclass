rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Firestore files 컬렉션에서 메타데이터 접근을 제어한다.
    // Storage는 로그인한 사용자의 업로드·읽기를 허용한다.
    match /files/{fileName} {
      allow read: if request.auth != null;
      // resumable 업로드는 create·update 모두 발생할 수 있음
      allow write: if request.auth != null
        && (request.resource == null || request.resource.size < 100 * 1024 * 1024);
    }
  }
}
