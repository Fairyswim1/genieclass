rules_version = '2';
// 배포: 프로젝트 연결 후 `firebase deploy --only firestore:rules`
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isTeacherUid(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isTeacherAuth() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isStudentAuth() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function classRef(classId) {
      return /databases/$(database)/documents/classes/$(classId);
    }

    function studentRef(studentId) {
      return /databases/$(database)/documents/students/$(studentId);
    }

    function assignmentRef(assignmentId) {
      return /databases/$(database)/documents/assignments/$(assignmentId);
    }

    function quizRef(quizId) {
      return /databases/$(database)/documents/quizzes/$(quizId);
    }

    function classExists(classId) {
      return exists(classRef(classId));
    }

    function isClassTeacher(classId) {
      return isTeacherAuth()
        && classId is string
        && classExists(classId)
        && get(classRef(classId)).data.teacherId == request.auth.uid;
    }

    function isStudentOwner(studentId) {
      return signedIn()
        && studentId is string
        && exists(studentRef(studentId))
        && get(studentRef(studentId)).data.authUid == request.auth.uid;
    }

    function ownsIncomingDoc() {
      return signedIn()
        && request.resource.data.authUid is string
        && request.resource.data.authUid == request.auth.uid;
    }

    function ownsExistingDoc() {
      return signedIn()
        && resource.data.authUid is string
        && resource.data.authUid == request.auth.uid;
    }

    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function passwordNotStored() {
      return !request.resource.data.keys().hasAny(['password']);
    }

    function studentInitialClaim() {
      return signedIn()
        && resource.data.loginId == ''
        && changedOnly(['loginId', 'password', 'passwordHash', 'passwordSalt', 'passwordVersion', 'passwordUpdatedAt', 'authUid', 'updatedAt'])
        && passwordNotStored()
        && request.resource.data.passwordHash is string
        && request.resource.data.passwordSalt is string
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.classId == resource.data.classId
        && request.resource.data.uniqueCode == resource.data.uniqueCode;
    }

    function studentAuthRefresh() {
      return signedIn()
        && changedOnly(['authUid', 'updatedAt'])
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.classId == resource.data.classId
        && request.resource.data.loginId == resource.data.loginId
        && request.resource.data.passwordHash == resource.data.passwordHash
        && request.resource.data.passwordSalt == resource.data.passwordSalt;
    }

    function studentSelfProfileUpdate() {
      return ownsExistingDoc()
        && changedOnly(['characterType', 'totalPoints', 'characterLevel', 'praiseCount', 'updatedAt'])
        && request.resource.data.classId == resource.data.classId
        && request.resource.data.authUid == resource.data.authUid;
    }

    function studentPasswordChange() {
      return ownsExistingDoc()
        && changedOnly(['password', 'passwordHash', 'passwordSalt', 'passwordVersion', 'passwordUpdatedAt', 'updatedAt'])
        && passwordNotStored()
        && request.resource.data.passwordHash is string
        && request.resource.data.passwordSalt is string
        && request.resource.data.classId == resource.data.classId
        && request.resource.data.authUid == resource.data.authUid
        && request.resource.data.loginId == resource.data.loginId;
    }

    function isStudentClassTeacher(studentId) {
      return isTeacherAuth()
        && studentId is string
        && exists(studentRef(studentId))
        && isClassTeacher(get(studentRef(studentId)).data.classId);
    }

    function classScopedRead() {
      return isClassTeacher(resource.data.classId) || isStudentAuth();
    }

    function presentationRead() {
      return isClassTeacher(resource.data.classId)
        || isStudentClassTeacher(resource.data.studentId)
        || (isStudentAuth() && isStudentOwner(resource.data.studentId))
        || presentationSharedToReaderClass();
    }

    function studentAuthClassId() {
      return get(/databases/$(database)/documents/student_auth/$(request.auth.uid)).data.classId;
    }

    function hasStudentAuthIndex() {
      return isStudentAuth()
        && exists(/databases/$(database)/documents/student_auth/$(request.auth.uid));
    }

    /** 같은 반 공유 또는 sharedClassIds에 내 반이 포함된 크로스클래스 공유 */
    function presentationSharedToReaderClass() {
      return resource.data.shared == true
        && hasStudentAuthIndex()
        && (
          studentAuthClassId() == resource.data.classId
          || (
            resource.data.keys().hasAny(['sharedClassIds'])
            && resource.data.sharedClassIds is list
            && studentAuthClassId() in resource.data.sharedClassIds
          )
        );
    }

    function presentationTeacherWrite() {
      return isClassTeacher(resource.data.classId)
        || isStudentClassTeacher(resource.data.studentId);
    }

    function presentationShareFieldsOnly() {
      return changedOnly(['shared', 'title', 'sharedClassIds', 'feedback', 'feedbackShared', 'feedbackAt', 'updatedAt']);
    }

    function classScopedCreate() {
      return isClassTeacher(request.resource.data.classId)
        || (ownsIncomingDoc() && isStudentOwner(request.resource.data.studentId));
    }

    function classScopedUpdate() {
      return isClassTeacher(resource.data.classId) || ownsExistingDoc();
    }

    function isAssignmentTeacher(assignmentId) {
      return signedIn()
        && assignmentId is string
        && exists(assignmentRef(assignmentId))
        && isClassTeacher(get(assignmentRef(assignmentId)).data.classId);
    }

    function isQuizTeacher(quizId) {
      return signedIn()
        && quizId is string
        && exists(quizRef(quizId))
        && isClassTeacher(get(quizRef(quizId)).data.classId);
    }

    function keepsClassScope() {
      return request.resource.data.classId == resource.data.classId
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function keepsStudentScope() {
      return keepsClassScope()
        && request.resource.data.studentId == resource.data.studentId;
    }

    function keepsTeacherScope() {
      return keepsClassScope()
        && request.resource.data.teacherId == resource.data.teacherId;
    }

    match /teachers/{teacherId} {
      allow read, write: if isTeacherUid(teacherId);
    }

    match /classes/{classId} {
      allow get: if signedIn();
      allow list: if isTeacherAuth() && resource.data.teacherId == request.auth.uid;
      allow create: if isTeacherAuth() && request.resource.data.teacherId == request.auth.uid;
      allow update: if isTeacherUid(resource.data.teacherId)
        && request.resource.data.teacherId == resource.data.teacherId
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdAt == resource.data.createdAt
        && changedOnly(['name', 'color', 'order', 'activeQuizId']);
      allow delete: if isTeacherUid(resource.data.teacherId);
    }

    match /student_auth/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.studentId is string
        && request.resource.data.classId is string
        && exists(studentRef(request.resource.data.studentId))
        && get(studentRef(request.resource.data.studentId)).data.authUid == request.auth.uid
        && get(studentRef(request.resource.data.studentId)).data.classId == request.resource.data.classId;
      allow delete: if false;
    }

    match /students/{studentId} {
      // 기존 학생 로그인 방식(학생코드/아이디 조회) 때문에 읽기는 당장 유지한다.
      // 쓰기는 교사 소유 학급 또는 학생 본인 인증 UID로 제한한다.
      allow read: if isClassTeacher(resource.data.classId)
        || isStudentAuth();
      allow create: if isClassTeacher(request.resource.data.classId);
      allow update: if isClassTeacher(resource.data.classId)
        && request.resource.data.classId == resource.data.classId
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdAt == resource.data.createdAt
        && changedOnly(['name', 'number', 'loginId', 'password', 'passwordHash', 'passwordSalt', 'passwordVersion', 'passwordUpdatedAt', 'authUid', 'characterLevel', 'characterType', 'praiseCount', 'totalPoints', 'updatedAt'])
        || studentInitialClaim()
        || studentAuthRefresh()
        || studentSelfProfileUpdate()
        || studentPasswordChange();
      allow delete: if isClassTeacher(resource.data.classId);
    }

    match /assignments/{assignmentId} {
      allow read: if classScopedRead();
      allow create: if isClassTeacher(request.resource.data.classId);
      allow update: if isClassTeacher(resource.data.classId)
        && keepsClassScope()
        && changedOnly(['title', 'description', 'dueDate', 'files', 'updatedAt']);
      allow delete: if isClassTeacher(resource.data.classId);
    }

    match /announcements/{announcementId} {
      allow read: if classScopedRead();
      allow create: if isClassTeacher(request.resource.data.classId);
      allow update: if isClassTeacher(resource.data.classId)
        && keepsClassScope()
        && changedOnly(['title', 'content', 'files', 'updatedAt']);
      allow delete: if isClassTeacher(resource.data.classId);
    }

    match /resources/{resourceId} {
      allow read: if classScopedRead();
      allow create: if isClassTeacher(request.resource.data.classId);
      allow update: if isClassTeacher(resource.data.classId)
        && keepsClassScope()
        && changedOnly(['title', 'description', 'files', 'updatedAt']);
      allow delete: if isClassTeacher(resource.data.classId);
    }

    match /problem_prompts/{promptId} {
      allow read: if classScopedRead();
      allow create: if isClassTeacher(request.resource.data.classId);
      allow update: if isClassTeacher(resource.data.classId)
        && keepsTeacherScope()
        && changedOnly(['title', 'description', 'files', 'modelAnswerText', 'modelAnswerFiles', 'updatedAt']);
      allow delete: if isClassTeacher(resource.data.classId);
    }

    match /quizzes/{quizId} {
      allow read: if classScopedRead();
      allow create: if isClassTeacher(request.resource.data.classId);
      allow update: if isClassTeacher(resource.data.classId)
        && keepsClassScope()
        && changedOnly(['active', 'galleryRevealed', 'problemImage', 'problemText', 'updatedAt']);
      allow delete: if isClassTeacher(resource.data.classId);
    }

    match /presentations/{presentationId} {
      allow read: if presentationRead();
      allow create: if classScopedCreate();
      allow update: if (
        presentationTeacherWrite()
        && keepsStudentScope()
        && presentationShareFieldsOnly()
      ) || (
        ownsExistingDoc()
        && keepsStudentScope()
        && request.resource.data.authUid == resource.data.authUid
        && presentationShareFieldsOnly()
      );
      allow delete: if presentationTeacherWrite()
        || ownsExistingDoc()
        || (isStudentAuth() && isStudentOwner(resource.data.studentId));
    }

    match /submissions/{submissionId} {
      allow read: if isAssignmentTeacher(resource.data.assignmentId)
        || ownsExistingDoc()
        || (isStudentAuth() && isStudentOwner(resource.data.studentId));
      allow create: if ownsIncomingDoc() && isStudentOwner(request.resource.data.studentId);
      allow update: if ownsExistingDoc()
        && request.resource.data.id == resource.data.id
        && request.resource.data.assignmentId == resource.data.assignmentId
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.authUid == resource.data.authUid
        && request.resource.data.createdAt == resource.data.createdAt
        && changedOnly(['files', 'textAnswer', 'audioData', 'shared', 'updatedAt']);
      allow delete: if ownsExistingDoc();
    }

    match /student_self_records/{recordId} {
      allow read: if classScopedRead();
      allow create: if classScopedCreate();
      allow update: if classScopedUpdate()
        && keepsStudentScope()
        && request.resource.data.authUid == resource.data.authUid
        && changedOnly(['title', 'content', 'files', 'updatedAt']);
      allow delete: if classScopedUpdate();
    }

    match /student_notes/{noteId} {
      allow read: if (isTeacherAuth() && resource.data.teacherId == request.auth.uid)
        || ownsExistingDoc()
        || (isStudentAuth() && isStudentOwner(resource.data.studentId));
      allow create: if classScopedCreate();
      allow update: if classScopedUpdate()
        && keepsTeacherScope()
        && request.resource.data.studentId == resource.data.studentId
        && changedOnly(['read', 'replyMessage', 'repliedAt', 'studentRead', 'updatedAt']);
      allow delete: if classScopedUpdate();
    }

    match /quiz_submissions/{submissionId} {
      allow read: if isQuizTeacher(resource.data.quizId) || ownsExistingDoc();
      allow create: if ownsIncomingDoc() && isStudentOwner(request.resource.data.studentId);
      allow update: if ownsExistingDoc()
        && request.resource.data.id == resource.data.id
        && request.resource.data.quizId == resource.data.quizId
        && request.resource.data.studentId == resource.data.studentId
        && request.resource.data.authUid == resource.data.authUid
        && request.resource.data.createdAt == resource.data.createdAt
        && changedOnly(['shared', 'solutionText', 'image', 'updatedAt']);
      allow delete: if ownsExistingDoc();
    }

    match /files/{fileId} {
      allow read: if signedIn();
      allow create: if ownsIncomingDoc();
      allow update, delete: if ownsExistingDoc();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
